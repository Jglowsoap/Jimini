run = "python replit_run.py"
modules = ["python-3.11"]

[nix]
channel = "stable-25_05"

[packager]
ignoredPackages = ["torch", "transformers", "spacy", "streamlit", "tensorflow", "pytorch"]

[deployment]
run = ["python", "replit_run.py"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8080
externalPort = 80

[env]
PYTHONPATH = "$REPL_HOME"
JIMINI_API_KEY = "jimini-api-key-10062025"
JIMINI_RULES_PATH = "policy_rules.yaml"
JIMINI_SHADOW = "0"
AUDIT_LOG_PATH = "logs/audit.jsonl"

[gitHubImport]
requiredFiles = [".replit", "replit_run.py", "requirements_deploy.txt"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python replit_run.py"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "webview"
