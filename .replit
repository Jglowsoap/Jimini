run = "python replit_main.py"
modules = ["python-3.11", "nodejs-20"]

[nix]
channel = "stable-25_05"

[deployment]
run = ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5000"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 9000
externalPort = 9000

[env]
PYTHONPATH = "$REPL_HOME"
JIMINI_API_KEY = "jimini-api-key-10062025"
JIMINI_RULES_PATH = "policy_rules.yaml"
JIMINI_SHADOW = "0"

AUDIT_LOG_PATH = "logs/audit.jsonl"

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "replit_main.py"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python replit_main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
