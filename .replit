run = "python replit_main.py"
modules = ["python-3.11", "nodejs-20"]

[nix]
channel = "stable-23.05"

[deployment]
run = ["python", "replit_main.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 46535
externalPort = 3000

[env]
PYTHONPATH = "$REPL_HOME"
JIMINI_API_KEY = "replit-jimini-gateway-2025"
JIMINI_RULES_PATH = "packs/government/v1_fixed.yaml"
JIMINI_SHADOW = "0"

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "replit_main.py"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python replit_main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
